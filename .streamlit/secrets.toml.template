# Copy this file to .streamlit/secrets.toml and fill values.
# Paste your full Google service account JSON fields below.
# Keep the private_key value on a single line with \n for line breaks.

[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""

[gsheets]
